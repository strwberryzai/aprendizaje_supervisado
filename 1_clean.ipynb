# %% [markdown]
# # Limpieza y análisis del dataset Titanic
# 
# Este cuaderno carga el dataset, revisa valores nulos, limpia las columnas relevantes y guarda una versión limpia en CSV.

# %%


# %% [markdown]
# 

# %%
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

# Cargar el dataset de Titanic sin depender de seaborn
url = 'https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv'
local_path = Path('data/titanic.csv')

if local_path.exists():
    df = pd.read_csv(local_path)
elif url:
    try:
        df = pd.read_csv(url)
    except Exception:
        raise FileNotFoundError('No se pudo cargar el dataset Titanic ni desde el archivo local ni desde la URL remota.')
else:
    raise FileNotFoundError('No se encontró el archivo data/titanic.csv y no hay acceso a la URL del dataset.')

print(f'El shape inicial es {df.shape}. {df.shape[0]} filas y {df.shape[1]} columnas.')
print(df.head())
print(df.info())

# Visualizar nulos usando matplotlib
plt.figure(figsize=(10, 6))
plt.imshow(df.isnull(), cmap='viridis', aspect='auto')
plt.colorbar(label='Valor nulo')
plt.xticks(range(len(df.columns)), df.columns, rotation=45, ha='right')
plt.yticks(range(len(df)), [])
plt.title('Mapa de calor de valores nulos')
plt.tight_layout()
plt.show()

missing_values_percentage = (df.isnull().mean() * 100).round(2).sort_values(ascending=False)
print(missing_values_percentage)

# Limpieza de columnas y valores faltantes
if 'Cabin' in df.columns:
    df = df.drop(columns=['Cabin'])

if 'Age' in df.columns:
    df['Age'] = df['Age'].fillna(df['Age'].median())

if 'Embarked' in df.columns:
    df['Embarked'] = df['Embarked'].fillna(df['Embarked'].mode()[0])

# Eliminar columnas irrelevantes
for col in ['Name', 'Ticket', 'PassengerId']:
    if col in df.columns:
        df = df.drop(columns=[col])

print(f'Después de limpiar df: {df.shape[0]} filas y {df.shape[1]} columnas.')
print('Valores nulos restantes:', df.isnull().sum().sum())
print('Duplicados:', df.duplicated().sum())

# Guardar output
output_dir = Path('data')
output_dir.mkdir(exist_ok=True)
df.to_csv(output_dir / 'titanic_clean.csv', index=False)

print('Archivo guardado en:', output_dir / 'titanic_clean.csv')


