import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# =========================
# CONFIG GENERAL ROSITA
# =========================
df = pd.read_csv('./data/titanic_clean.csv')

PINK = {
    "bg": "#FFF5FA",
    "p1": "#F8BBD0",
    "p2": "#F48FB1",
    "p3": "#EC407A",
    "p4": "#AD1457",
    "line1": "#C2185B",
    "line2": "#880E4F"
}

sns.set_theme(style="whitegrid", rc={"axes.facecolor": PINK["bg"], "figure.facecolor": "white"})
sns.set_palette([PINK["p1"], PINK["p2"], PINK["p3"], PINK["p4"]])

def finish_plot(title, xlabel="", ylabel="", rot=0):
    plt.title(title, fontsize=13)
    plt.xlabel(xlabel)
    plt.ylabel(ylabel)
    plt.xticks(rotation=rot)
    plt.grid(alpha=0.25, axis="y")
    plt.tight_layout()
    plt.show()

# =========================
# 1) DISTRIBUCIONES / CONTEOS
# =========================
plt.figure(figsize=(7,4))
sns.countplot(data=df, x="Survived", hue="Survived", legend=False)
finish_plot("Conteo de Supervivencia", "Survived", "Cantidad")

plt.figure(figsize=(8,5))
ax = sns.countplot(data=df, x="Pclass", hue="Survived")
ax.legend(title="Supervivencia", labels=["No sobrevivió", "Sobrevivió"])
finish_plot("Tasa de Supervivencia por Clase", "Clase", "Total")

plt.figure(figsize=(8,5))
ax = sns.countplot(data=df, x="Sex", hue="Survived")
ax.legend(title="Supervivencia", labels=["No sobrevivió", "Sobrevivió"])
finish_plot("Tasa de Supervivencia por Sexo", "Sexo", "Total")

plt.figure(figsize=(8,5))
ax = sns.countplot(data=df, x="Embarked", hue="Survived")
ax.legend(title="Supervivencia", labels=["No sobrevivió", "Sobrevivió"])
finish_plot("Supervivencia por Puerto de Embarque", "Embarked", "Total")

# =========================
# 2) HISTOGRAMAS + LINEAS
# =========================
def hist_with_stats(col, bins=30, title=""):
    s = df[col].dropna()
    mean_, med_, mode_ = s.mean(), s.median(), s.mode().iloc[0]

    plt.figure(figsize=(9,5))
    sns.histplot(s, bins=bins, kde=True, color=PINK["p2"])
    plt.axvline(mean_, color=PINK["line1"], ls="--", lw=2, label=f"Media: {mean_:.2f}")
    plt.axvline(med_,  color=PINK["p4"],   ls="--", lw=2, label=f"Mediana: {med_:.2f}")
    plt.axvline(mode_, color=PINK["line2"], ls="--", lw=2, label=f"Moda: {mode_:.2f}")
    plt.legend()
    finish_plot(title or f"Distribución de {col}", col, "Frecuencia")

hist_with_stats("Age", bins=30, title="Distribución de Edad")
hist_with_stats("Fare", bins=40, title="Distribución de Tarifa")

# =========================
# 3) BOXPLOTS
# =========================
for col in ["Age", "Fare"]:
    plt.figure(figsize=(6,4))
    plt.boxplot(
        df[col].dropna(),
        patch_artist=True,
        boxprops=dict(facecolor=PINK["p1"], color=PINK["p4"]),
        medianprops=dict(color=PINK["line2"], linewidth=2)
    )
    finish_plot(f"Boxplot de {col}", "", col)

# =========================
# 4) RELACIONES
# =========================
plt.figure(figsize=(7,5))
sns.scatterplot(data=df, x="Age", y="Fare", color=PINK["p3"], alpha=0.65)
finish_plot("Relación Edad vs Tarifa", "Edad", "Tarifa")

plt.figure(figsize=(8,6))
corr_cols = ["Survived", "Pclass", "Age", "SibSp", "Parch", "Fare"]
sns.heatmap(df[corr_cols].corr(), annot=True, cmap="RdPu", center=0, fmt=".2f", linewidths=.5)
finish_plot("Correlación de Variables Numéricas")

# =========================
# 5) EJERCICIOS RESUMIDOS (sin repetir tanto)
# =========================

# Sobrevivientes por clase / sexo / puerto
for col, title in [
    ("Pclass", "Sobrevivientes por Clase"),
    ("Sex", "Sobrevivientes por Género"),
    ("Embarked", "Sobrevivientes por Puerto")
]:
    plt.figure(figsize=(7,4))
    (df.groupby(col)["Survived"].sum()
       .plot(kind="bar", color=PINK["p2"], edgecolor=PINK["p4"]))
    finish_plot(title, col, "Cantidad", rot=0 if col!="Embarked" else 45)

# Conteo por clase y por sexo
for col, title in [
    ("Pclass", "Conteo de Pasajeros por Clase"),
    ("Sex", "Conteo de Pasajeros por Género"),
    ("SibSp", "Conteo de Pasajeros por SibSp")
]:
    plt.figure(figsize=(7,4))
    df[col].value_counts().sort_index().plot(kind="bar", color=PINK["p1"], edgecolor=PINK["p4"])
    finish_plot(title, col, "Cantidad")

# Tasa supervivencia por SibSp
plt.figure(figsize=(7,4))
(df.groupby("SibSp")["Survived"].mean()*100).plot(kind="bar", color=PINK["p3"], edgecolor=PINK["line2"])
finish_plot("Tasa de Supervivencia por SibSp", "SibSp", "Tasa (%)")

# Grupo de edad
def categorizar_edad(age):
    if pd.isna(age): return "Desconocido"
    if age < 3: return "Infante"
    if age < 13: return "Niño"
    if age < 18: return "Adolescente"
    if age < 35: return "Joven Adulto"
    if age < 60: return "Adulto"
    return "Mayor"

df["Grupo_Edad"] = df["Age"].apply(categorizar_edad)

plt.figure(figsize=(8,4))
(df.groupby("Grupo_Edad")["Survived"].mean()*100).reindex(
    ["Infante","Niño","Adolescente","Joven Adulto","Adulto","Mayor","Desconocido"]
).plot(kind="bar", color=PINK["p2"], edgecolor=PINK["p4"])
finish_plot("Tasa de Supervivencia por Grupo de Edad", "Grupo", "Tasa (%)", rot=30)

# Datos puntuales
print(f"Edad máxima: {df['Age'].max()} | Edad mínima: {df['Age'].min()}")
print(f"Tarifa máxima: {df['Fare'].max()} | Tarifa mínima: {df['Fare'].min()}")

zero_fare = df[df["Fare"] == 0]
print(f"Pasajeros con tarifa 0: {len(zero_fare)}")
display(zero_fare.head())
